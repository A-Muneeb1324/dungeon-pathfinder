{
  "version": 2,
  "builds": [
    {
      "src": "api/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": ["static/**", "templates/**", "game/**", "api/**"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/wsgi.py" }
  ]
}
